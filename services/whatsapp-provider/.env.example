# Copy to .env in THIS directory; never commit it.
PROVIDER_HOST=127.0.0.1
PROVIDER_PORT=3100
# Same random secret as Laravel GYM_WHATSAPP_TOKEN, at least 32 characters.
PROVIDER_TOKEN=
# Separate management secret; match Laravel GYM_WHATSAPP_ADMIN_TOKEN.
PROVIDER_ADMIN_TOKEN=
# Prefer an absolute persistent path OUTSIDE the website/document root.
PROVIDER_DATA_DIR=./data
# Optional installed Chrome path; otherwise use Puppeteer's downloaded browser.
# CHROME_EXECUTABLE_PATH=
